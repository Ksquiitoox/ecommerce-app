/*------------------------------------
GENERAL
------------------------------------*/
body {
  margin: 0;
  padding-top: 80px; /* espacio para el navbar */
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #f5f5f5;
}

/*------------------------------------
NAVBAR
------------------------------------*/
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #0f172a;
  padding: 0 20px;
  position: fixed;
  top: 0;
  width: 100%;
  height: 80px; /* altura fija */
  z-index: 100;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  animation: slideDown 0.8s ease-out forwards;
  overflow-x: hidden; /* evita scroll horizontal */
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
}
.logo img {
  width: 50px;
  height: 50px;
}
.logo h1 {
  color: #ffffff;
  font-size: 1.5rem;
  margin: 0;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 15px;
  margin: 0;
  padding: 0;
  flex-wrap: wrap; /* permite que bajen en móviles */
}

.nav-links li {
  flex: 0 1 auto; /* ajusta automáticamente sin romper layout */
}

.nav-links a {
  color: #ffffff;
  text-decoration: none;
  font-weight: bold;
  padding: 10px 8px;
  display: block;
  transition: color 0.3s;
}
.nav-links a:hover,
.nav-links a.active {
  color: #38bdf8;
  border-bottom: 2px solid #38bdf8;
}

/* Scrollbar oculto */
.navbar::-webkit-scrollbar {
  display: none;
}

/* Animación navbar */
@keyframes slideDown {
  from { opacity: 0; transform: translateY(-50px); }
  to { opacity: 1; transform: translateY(0); }
}

/*------------------------------------
FORMULARIO LOGIN / REGISTRO
------------------------------------*/
.form-container {
  max-width: 400px;
  margin: 100px auto;
  padding: 30px;
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 0 15px rgba(0,0,0,0.1);
  text-align: center;
}

.form-container h2 {
  margin-bottom: 20px;
  color: #0f172a;
}

.form-box {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

/* ICONOS EN INPUTS */
.input-icon {
  position: relative;
  width: 100%;
}
.input-icon .icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  font-size: 1.2rem;
  color: #888;
}
.input-icon input {
  width: 100%;
  padding: 10px 10px 10px 35px;
  border: 1px solid #cbd5e1;
  border-radius: 5px;
  font-size: 1rem;
  transition: all 0.3s;
}

/* VALIDACION */
input:invalid { border-color: red; }
input:valid { border-color: green; }

/* ENFOQUE */
input:focus {
  border-color: #38bdf8;
  box-shadow: 0 0 5px #38bdf8;
  outline: none;
}

/* BOTONES */
button {
  background-color: #38bdf8;
  color: #0f172a;
  border: none;
  padding: 10px;
  border-radius: 5px;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.3s;
}
button:hover { background-color: #0ea5e9; }

/* LINK ALTERNATIVO */
.alt-link {
  margin-top: 10px;
}
.alt-link a {
  color: #38bdf8;
  text-decoration: none;
  font-weight: bold;
}
.alt-link a:hover { text-decoration: underline; }

/*------------------------------------
RESPONSIVO
------------------------------------*/
@media (max-width: 768px) {
  .banner h2 { font-size: 1.8rem; }
  .banner p { font-size: 1rem; }
  .input-icon input { padding-left: 35px; }
  .nav-links a { font-size: 0.9rem; padding: 8px; }
}

@media (max-width: 500px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    height: auto; /* deja que crezca */
    padding: 10px;
  }
  .nav-links {
    flex-direction: column;
    gap: 5px;
    width: 100%;
  }
  .nav-links a {
    width: 100%;
  }
}