

/* BANNER */
.banner {
  width: 100%;
  height: 400px;
  background: url("https://images.unsplash.com/photo-1518770660439-4636190af475") center/cover no-repeat;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: white;
}

.banner-content h2 {
  font-size: 40px;
  margin-bottom: 10px;
}

.btn-banner {
  display: inline-block;
  background-color: #0f172a;
  padding: 12px 25px;
  color: white;
  border-radius: 5px;
  text-decoration: none;
  margin-top: 10px;
}

/* TITULOS DE CATEGORIA */
.category-title {
  text-align: center;
  margin: 50px 0 20px;
  font-size: 28px;
}

/* CONTENEDOR GRID */
.products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  width: 90%;
  margin: auto;
}

/* CARD DE PRODUCTO */
.product-card {
  background: white;
  padding: 15px;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0px 2px 8px rgba(0,0,0,0.15);
  transition: transform 0.2s ease;
}

.product-card:hover {
  transform: translateY(-5px);
}

.product-img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  border-radius: 10px;
}

.product-title {
  margin: 10px 0;
  font-size: 18px;
}

.product-price {
  color: #0f172a;
  font-weight: bold;
  margin-bottom: 10px;
}

.btn-product {
  background-color: #0f172a;
  color: white;
  padding: 10px 15px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}