<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>TecnoStore | Home</title>
  <!-- VINCULO AL CSS -->
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
  <!-- NAVBAR -->
  <header class="navbar">
    <div class="navbar-left">
      <!-- LOGO DE LA TIENDA -->
      <a href="/index.html">
        <img src="img/logo.png" alt="Logo TecnoStore" class="navbar-logo">
      </a>
      <h1 class="navbar-title">TecnoStore</h1>
    </div>

    <!-- LINKS DE NAVEGACIÓN -->
    <nav>
      <ul class="navbar-links">
        <li><a href="/index.html">Home</a></li>
        <li><a href="/pages/Laptops.html">Laptops</a></li>
        <li><a href="/pages/Smartphones.html">Smartphones</a></li>
        <li><a href="/pages/Accesorios.html">Accesorios</a></li>
        <li><a href="/pages/Login.html">Ingresar</a></li>
        <li><a href="/pages/Register.html">Registrarse</a></li>
      </ul>
    </nav>

    <!-- BOTÓN LOGOUT -->
    <button type="button" class="btn-logout">Logout</button>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main>
    <!-- TÍTULO EN EL BODY (LO QUE PIDE LA CONSIGNA) -->
    <section class="hero">
      <h1>TecnoStore</h1>
      <p>Bienvenido a TecnoStore, tu tienda de tecnología online.</p>
    </section>

    <!-- SECCIÓN DE CARDS (LAYOUT + UNA CARD PROTOTIPO) -->
    <section class="card-seccion">
      <h3>Producto destacado</h3>
      <div class="seccion-cuadricula">
        <!-- Prototipo de card de producto -->
        <article class="card-contenedor">
          <span class="card-etiqueta">Laptop</span>
          <h4 class="card-titulo">Laptop Gamer RTX</h4>
          <p class="card-descripcion">Rendimiento ideal para estudio, trabajo y juegos.</p>
          <p class="card-precio">$ 1.200.000</p>
          <button type="button" class="btn-primario">Ver más</button>
        </article>
      </div>
    </section>
  </main>
</body>
</html>
